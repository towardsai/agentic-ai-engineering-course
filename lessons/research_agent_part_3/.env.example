# Agent variables
OPENAI_API_KEY=...
# Gemini authentication. Default: Gemini Developer API key from Google AI Studio.
GOOGLE_API_KEY=...
# Optional alternative: call Gemini through Vertex AI instead (uses your GCP free trial credits).
# Locally, authenticate first with `gcloud auth application-default login`; on Cloud Run the
# runtime service account is used automatically. Then uncomment:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# Web search uses Perplexity by default. Set to "tavily" to use Tavily instead.
WEB_SEARCH_PROVIDER=perplexity
TAVILY_API_KEY=...
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5
TAVILY_CHUNKS_PER_SOURCE=3
PPLX_API_KEY=...
FIRECRAWL_API_KEY=...
OPIK_API_KEY=...
OPIK_WORKSPACE=...
OPIK_PROJECT_NAME=...
GITHUB_TOKEN=...

# Descope authentication
SERVER_URL="http://0.0.0.0:8000"
DESCOPE_PROJECT_ID=
DESCOPE_BASE_URL=https://api.descope.com
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database (defaults work fine)
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova_dev_password
POSTGRES_DB=nova_research
