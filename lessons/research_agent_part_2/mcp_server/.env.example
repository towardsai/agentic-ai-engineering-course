# Gemini authentication. Default: Gemini Developer API key from Google AI Studio.
GOOGLE_API_KEY=...
# Optional alternative: call Gemini through Vertex AI instead (uses your GCP free trial credits).
# Authenticate first with `gcloud auth application-default login`, then uncomment:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Web search uses Perplexity by default. Set to "tavily" to use Tavily instead.
WEB_SEARCH_PROVIDER=perplexity
TAVILY_API_KEY=...
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5
TAVILY_CHUNKS_PER_SOURCE=3
PPLX_API_KEY=...
FIRECRAWL_API_KEY=...
OPIK_API_KEY=...
GITHUB_TOKEN=...
