 # --- Gemini (Required since the beginning) ---
# Default: Gemini Developer API key from Google AI Studio.
GOOGLE_API_KEY=

# Optional alternative: call Gemini through Vertex AI instead (uses your GCP free trial credits).
# Authenticate first with `gcloud auth application-default login`, then uncomment:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# --- Firecrawl (Starting with Part 2) ---
FIRECRAWL_API_KEY=

# --- Web search (Starting with Part 2; Perplexity is the default) ---
WEB_SEARCH_PROVIDER=perplexity
PPLX_API_KEY=

# --- Optional Tavily alternative (Starting with Part 2) ---
TAVILY_API_KEY=

# --- GitHub Access Token (Starting with Part 2 - Optional, for private repositories) ---
GITHUB_TOKEN=

# --- Opik (Starting with Part 3) ---
OPIK_API_KEY=
